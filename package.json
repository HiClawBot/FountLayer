{
  "name": "fountlayer",
  "version": "0.5.0-beta.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "beta:doctor": "node scripts/beta-doctor.mjs",
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean && rm -rf coverage",
    "db:backup": "node scripts/backup-database.mjs",
    "db:migrate": "pnpm --filter @fountlayer/db db:migrate",
    "db:restore:verify": "node scripts/verify-database-restore.mjs",
    "db:seed": "pnpm --filter @fountlayer/db db:seed",
    "db:test:setup": "pnpm --filter @fountlayer/db db:test:setup",
    "dev": "pnpm -r --parallel --if-present dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "fixture:openai": "node scripts/openai-compatible-fixture.mjs",
    "lint": "eslint .",
    "release:verify": "node scripts/verify-release-identity.mjs",
    "scan:keys": "node scripts/strict-key-scan.mjs",
    "smoke:sdk-package": "node scripts/smoke-sdk-package.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:site": "node scripts/smoke-site.mjs",
    "third-party:inventory": "node scripts/generate-third-party-inventory.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fountlayer/money": "workspace:*",
    "@fountlayer/session-ticket": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4",
      "next>postcss": "8.5.21",
      "sharp": "0.35.3"
    }
  }
}
