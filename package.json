{
  "name": "fountlayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean && rm -rf coverage",
    "db:migrate": "pnpm --filter @fountlayer/db db:migrate",
    "db:seed": "pnpm --filter @fountlayer/db db:seed",
    "db:test:setup": "pnpm --filter @fountlayer/db db:test:setup",
    "dev": "pnpm -r --parallel --if-present dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:site": "node scripts/smoke-site.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  }
}
