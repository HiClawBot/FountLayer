# Copy to a private file outside Git or to `.env.production`, then replace every
# `replace_with_*` value. Never commit the populated file.
FOUNTLAYER_IMAGE_TAG=0.5.0-beta.2
FOUNTLAYER_VCS_REF=replace_with_release_commit_sha

POSTGRES_DB=fountlayer
POSTGRES_USER=fountlayer
POSTGRES_PASSWORD=replace_with_high_entropy_database_password
DATABASE_URL=postgres://fountlayer:replace_with_url_encoded_database_password@postgres:5432/fountlayer

# The Console keeps the plaintext Gateway Admin token server-side. The Gateway
# receives only its lowercase SHA-256 digest.
CONSOLE_GATEWAY_ADMIN_TOKEN=replace_with_high_entropy_gateway_admin_token
FOUNTLAYER_ADMIN_TOKEN_SHA256=replace_with_gateway_admin_token_sha256
FOUNTLAYER_CREDENTIAL_MASTER_KEY=base64:replace_with_32_random_bytes_in_base64
FOUNTLAYER_CREDENTIAL_KEY_VERSION=beta-v1
FOUNTLAYER_SESSION_TICKET_SECRET=replace_with_independent_32_byte_ticket_secret
FOUNTLAYER_UPSTREAM_TIMEOUT_MS=30000
FOUNTLAYER_SHUTDOWN_GRACE_MS=15000

CONSOLE_OPERATOR_TOKEN_SHA256=replace_with_console_operator_token_sha256
CONSOLE_SESSION_SECRET=replace_with_independent_32_byte_console_session_secret
CONSOLE_SESSION_COOKIE_SECURE=true

LITELLM_MASTER_KEY=replace_with_high_entropy_litellm_master_key
UPSTREAM_OPENAI_BASE_URL=https://replace_with_openai_compatible_base_url/v1
UPSTREAM_OPENAI_API_KEY=replace_with_upstream_provider_key
UPSTREAM_OPENAI_MODEL=replace_with_upstream_model_identifier

# This value is embedded into the Demo browser bundle at image build time.
NEXT_PUBLIC_GATEWAY_BASE_URL=https://replace_with_public_gateway_origin
